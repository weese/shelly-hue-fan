# Zigbee
CONFIG_ZB_ENABLED=y
CONFIG_ZB_RADIO_NATIVE=y
CONFIG_ZB_ZCZR=y

# IEEE 802.15.4
CONFIG_IEEE802154_ENABLED=y

# FreeRTOS
CONFIG_FREERTOS_HZ=100
CONFIG_FREERTOS_UNICORE=y

# Stack sizes
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Flash is 8 MB — required so the dual-OTA partition table fits (the default is
# 2 MB, which makes the partition generator reject ota_0/ota_1 + zb_storage).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Custom partition table with Zigbee NVS storage
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="$ENV{PROJECT_DIR}/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="$ENV{PROJECT_DIR}/partitions.csv"

# Console — use UART0 (the debug-header TX/RX pins), not USB-Serial-JTAG,
# so logs are visible on an external USB-UART adapter wired to the header.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n

# WiFi — used ONLY by the setup portal (a separate boot mode); never runs at the
# same time as Zigbee, so no coexistence is needed.
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y

# HTTP server — browsers (and captive-portal webviews) send large header blocks;
# the 512-byte default rejects form POSTs and OTA uploads with
# "Header fields are too long". Raise the request header + URI limits.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=768

# Disable unused
CONFIG_BT_ENABLED=n
CONFIG_LWIP_IPV6=n

# NVS
CONFIG_NVS_ENCRYPTION=n

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
